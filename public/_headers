# Cloudflare Pages Static Assets & High-Performance Headers

# Global Security, Timing & Optimization
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Timing-Allow-Origin: *
  Access-Control-Allow-Origin: *

# Rutas Privadas del Usuario (No indexar en buscadores, sin almacenamiento en proxy)
/boveda/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

/cuenta
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

/acceso
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

# Immutable Static CSS & JS Assets
/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Next.js static builds
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# App Logo and Favicons (Immutable Edge Cache)
/velvet_logo.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

# Web App Manifest
/manifest.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Service Worker (Always revalidate immediately for fresh code)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# SPA HTML Shell (zero-delay instant deploys)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
