# Cloudflare Pages Static Assets & High-Performance Headers

# Global Security, Timing & Strict Content Policies
# JUSTIFICACIÓN TÉCNICA DE DIRECTIVAS CSP:
# - script-src 'unsafe-inline': Necesario para los bloques de script de la SPA en public/index.html (gestión de estado, router, lector).
# - script-src 'unsafe-eval': Exclusivamente requerido por Tailwind Play CDN (cdn.tailwindcss.com) para compilar clases JIT en el navegador con Function().
# - worker-src / child-src 'self' blob:: Requerido por HLS.js para workers demuxer inline creados con URL.createObjectURL(new Blob([...])).
# - style-src 'unsafe-inline': Requerido para transformaciones GPU dinámicas (translate3d) y estilos inyectados por Tailwind y Lucide.
# - connect-src 'self' blob: https://*.supabase.co https://pmvhaven.com: API Supabase, streaming HLS y analítica Cloudflare.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self' blob: https:; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://unpkg.com https://*.serverable.com; worker-src 'self' blob:; child-src 'self' blob: https://*.serverable.com https://*.gamcore.com; frame-src 'self' blob: https://*.serverable.com https://*.gamcore.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: data: https://*.supabase.co https://pmvhaven.com https://cloudflareinsights.com https://unpkg.com https://*.serverable.com https://*.gamcore.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

# Catálogos internos (no accesibles directamente ni indexables)
/data/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

# Rutas Privadas del Usuario (No indexar en buscadores, sin almacenamiento en proxy)
/boveda/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

/cuenta
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

/acceso
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

# Immutable Static CSS & JS Assets
/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

/css/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.css
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Next.js static builds
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# App Logo, Favicons and Static Media Icons (Immutable Edge Cache)
/velvet_logo.png
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.png
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Web App Manifest
/manifest.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

# Service Worker (Always revalidate immediately for fresh code)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# SPA HTML Shell (zero-delay instant deploys)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
