# Cloudflare Pages Static Assets & High-Performance Headers

# Global Security, Timing & Strict Content Policies
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: https://*.supabase.co https://pmvhaven.com https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

# Rutas Privadas del Usuario (No indexar en buscadores, sin almacenamiento en proxy)
/boveda/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

/cuenta
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

/acceso
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store, must-revalidate

# Immutable Static CSS & JS Assets
/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

/*.css
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Next.js static builds
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# App Logo and Favicons (Immutable Edge Cache)
/velvet_logo.png
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Web App Manifest
/manifest.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

# Service Worker (Always revalidate immediately for fresh code)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# SPA HTML Shell (zero-delay instant deploys)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
