# Copia a .env.local para desarrollo. En Vercel van como variables de entorno.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Correo de la cuenta maestra (la única que puede generar llaves)
MASTER_EMAIL=
# Protección de Origen Cloudflare (Bearer Token)
# Si se activa, las APIs rechazan cualquier petición que no venga del proxy de Cloudflare.
CLOUDFLARE_BEARER_TOKEN=
