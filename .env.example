# ==============================================================================
# VELVET HUB / MORBOHUB - PLANTILLA DE VARIABLES DE ENTORNO UNIFICADA (.env.example)
# NUNCA incluyas secretos reales en este archivo ni lo subas a repositorios públicos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (REQUERIDAS)
# ------------------------------------------------------------------------------
# URL base del proyecto Supabase (Dashboard -> Settings -> API -> Project URL)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública 'anon' (Dashboard -> Settings -> API -> anon public)
# Permite consultas del catálogo público con políticas RLS activas
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Clave administrativa 'service_role' (Dashboard -> Settings -> API -> service_role secret)
# CRÍTICO: SOLO para Pages Functions en el servidor. NUNCA se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# ------------------------------------------------------------------------------
# 1b. SUPABASE SHORTS (SEGUNDA BASE DE DATOS INDEPENDIENTE - VIDEOS CORTOS +18)
# ------------------------------------------------------------------------------
SUPABASE_URL_SHORTS=https://gfzmxupwzbsdmjjiagnl.supabase.co
SUPABASE_ANON_KEY_SHORTS=tu_supabase_anon_o_publishable_key_shorts_aqui
SUPABASE_SERVICE_ROLE_KEY_SHORTS=opcional_service_role_shorts

# ------------------------------------------------------------------------------
# 2. CRIPTOGRAFÍA Y MEDIOS STEALTH (REQUERIDA)
# ------------------------------------------------------------------------------
# Secreto de 256 bits (64 hex) para firma Web Crypto HMAC-SHA256 de /api/media
# Generar localmente con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_SECRET=tu_clave_secreta_de_al_menos_64_caracteres_hex_aqui

# ------------------------------------------------------------------------------
# 3. ENTORNO Y OPTIMIZACIÓN (OPCIONALES)
# ------------------------------------------------------------------------------
# Identificador del entorno ('production' o 'preview')
ENVIRONMENT=production

# Modo de conteo en PostgREST ('count=exact' o 'count=estimated' para >100k items)
POSTGREST_COUNT_MODE=count=exact

# Habilitar o deshabilitar llamadas en vivo al API de PMVHaven ('true' o 'false')
ENABLE_PMVHAVEN_LIVE=true

# ------------------------------------------------------------------------------
# 4. INTEGRACIÓN PATREON OAUTH2 (OPCIONALES)
# ------------------------------------------------------------------------------
PATREON_CLIENT_ID=tu_patreon_client_id
PATREON_CLIENT_SECRET=tu_patreon_client_secret
PATREON_CAMPAIGN_ID=tu_patreon_campaign_id
