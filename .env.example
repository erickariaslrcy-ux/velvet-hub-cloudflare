# ==============================================================================
# VELVET HUB / MORBOHUB - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# NUNCA incluyas secretos reales en este archivo ni lo subas a repositorios públicos.
# ==============================================================================

# 1. Supabase (Base de Datos y Autenticación)
# URL del proyecto Supabase (ej: https://xxxx.supabase.co)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública anónima (para lecturas públicas y autenticación de usuarios con RLS)
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Clave de servicio administrativo (SOLO para backend / Pages Functions, NUNCA en el cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# 2. Criptografía y Protección de Medios (HMAC-SHA256)
# Clave secreta simétrica utilizada exclusivamente en el servidor para firmar tokens de medios
MEDIA_SECRET=tu_clave_secreta_de_al_menos_32_caracteres_hex_o_aleatorios

# 3. Integración con Patreon OAuth2 (Opcional)
PATREON_CLIENT_ID=tu_patreon_client_id
PATREON_CLIENT_SECRET=tu_patreon_client_secret
PATREON_CAMPAIGN_ID=tu_patreon_campaign_id
MASTER_EMAIL=admin@ejemplo.com

# 4. Seguridad Cloudflare (Opcional)
# Token de portador para validar que el tráfico proviene exclusivamente de Cloudflare
CLOUDFLARE_BEARER_TOKEN=tu_cloudflare_bearer_token
